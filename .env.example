PORT=3189
HOST=127.0.0.1

SOURCE_MODE=prebuilt
SUBSET_FALLBACK_MODE=error

PREBUILD_STATIC_SOURCES=1
PREBUILD_STATIC_FILLS=0,mixed
PREBUILD_STATIC_GRADES=0
PREBUILD_STATIC_OPTICAL_SIZES=24

FONT_SOURCE_PATH_OUTLINED=src/fonts/Material-Outlined.woff2
FONT_SOURCE_PATH_ROUNDED=src/fonts/Material-Rounded.woff2
FONT_SOURCE_PATH_SHARP=src/fonts/Material-Sharp.woff2

# Subset workers (empty: CPU cores minus one, at most 4; 0: main thread)
SUBSET_WORKERS=
PREBUILD_ICON_NAMES=1
SUBSET_GLYPHS=1
